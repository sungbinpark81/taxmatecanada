{
  "version": 2,
  "builds": [
    { "src": "api/subscribe.js", "use": "@vercel/node" },
    { "src": "api/chat.js",      "use": "@vercel/node" },
    { "src": "index.html",       "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/subscribe", "dest": "/api/subscribe.js" },
    { "src": "/api/chat",      "dest": "/api/chat.js" },
    { "src": "/(.*)",          "dest": "/index.html" }
  ]
}
